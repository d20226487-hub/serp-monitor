# SerpAPI key — https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Single-user basic auth (set both to enable Caddy basic auth)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD_HASH=

# SITE_HOST = the address Caddy listens on INSIDE the container.
#   Local/IP testing:        :80
#   Public domain w/ TLS:    monitor.example.com
SITE_HOST=:80

# Host ports published by Docker. Keep 8080/8443 on Windows where port 80
# is often reserved by the system. For a public deploy use 80/443.
HTTP_PORT=8080
HTTPS_PORT=8443

# Backend
DATABASE_URL=sqlite:////data/serp.db
TZ=UTC

# Concurrency for SerpAPI calls per job run
SERPAPI_CONCURRENCY=8

# Optional: cap total credits a single job run may consume (safety belt)
MAX_QUERIES_PER_RUN=2000
