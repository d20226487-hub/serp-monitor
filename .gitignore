# Secrets & runtime data
.env
# Repo-root SQLite volume ONLY. Anchored with a leading slash so it does NOT
# also match backend/app/data/ — that dir holds shipped languages/google-domain
# /seed-location JSON the app needs at runtime and MUST be committed.
/data/

# Backend
backend/__pycache__/
backend/**/__pycache__/
backend/.venv/
backend/*.db

# Frontend
frontend/.next/
frontend/node_modules/
frontend/out/
node_modules/

# Build / runtime artifacts
*.log
build*.log
*.pid
*.swp
*.bak

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor / tooling
.vscode/
.idea/
*.iml

# Caddy local persistence (if anyone bind-mounts it)
caddy_data/
caddy_config/
